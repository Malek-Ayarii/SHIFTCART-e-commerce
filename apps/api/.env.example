# SHIFT CART API — variables d'environnement (toutes optionnelles en dev, voir application.yml).
# Copier en .env (non versionné) ou les exporter avant ./mvnw spring-boot:run.

# --- Serveur -------------------------------------------------------------------
PORT=8090
# Profil local avec données de démo : dev. En production : laisser vide (ou "prod").
SPRING_PROFILES_ACTIVE=dev
# native : X-Forwarded-For cru seulement depuis un proxy interne (boutique Next.js, LB privé). "none" pour l'ignorer.
FORWARD_HEADERS_STRATEGY=native
# Regex des proxies de confiance si la boutique / le LB a une IP publique (défaut Tomcat : réseaux privés + loopback).
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=

# --- Base de données (docker compose : localhost:5600, base/utilisateur/mdp shiftcart) ---
DATABASE_URL=jdbc:postgresql://localhost:5600/shiftcart
DATABASE_USER=shiftcart
DATABASE_PASSWORD=shiftcart

# --- URLs / CORS -----------------------------------------------------------------
SHOP_PUBLIC_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4300

# --- Secrets (OBLIGATOIRES hors profil dev, ≥ 32 caractères ; sinon l'API ne démarre pas) ---
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
TRACKING_TOKEN_SECRET=change-me-to-another-long-random-secret-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
# true par défaut (HTTPS) ; le profil dev le met à false (http://localhost).
# COOKIE_SECURE=true

# --- Compte admin créé au premier démarrage (table admin_user vide) -----------------
ADMIN_EMAIL=admin@shiftcart.tn
# Obligatoire hors dev (défaut dev : shiftcart-dev, refusé ailleurs).
# ADMIN_PASSWORD=
ADMIN_NAME=Admin
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=10m

# --- Commandes ----------------------------------------------------------------------
# Limites anti-abus de POST /api/orders (en mémoire, par instance).
ORDER_RATE_LIMIT_IP_MAX=5
ORDER_RATE_LIMIT_IP_WINDOW=10m
ORDER_RATE_LIMIT_PHONE_MAX=3
ORDER_RATE_LIMIT_PHONE_WINDOW=30m
ORDER_DUPLICATE_WINDOW=30m
# Passage automatique NEW → PENDING après N heures sans réponse. 0 = désactivé. [À DÉFINIR] (ex. 6)
ORDER_AUTO_PENDING_HOURS=0

# --- Finances / stock ------------------------------------------------------------------
# Frais transporteur par colis en TND. [À DÉFINIR] — 7 = valeur d'exemple des maquettes.
CARRIER_FEE_TND=7
# Alerte quand les packs complets passent sous ce seuil.
PACK_ALERT_THRESHOLD=5

# --- WhatsApp Business Cloud API --------------------------------------------------------
# Numéro de la boutique pour les liens wa.me, format 216XXXXXXXX. [À DÉFINIR]
WHATSAPP_SHOP_NUMBER=
# Sans TOKEN + PHONE_NUMBER_ID, les envois sont SIMULATED (rien ne part).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Jeton choisi lors de l'abonnement du webhook (GET /api/webhooks/whatsapp).
WHATSAPP_VERIFY_TOKEN=
# Secret de l'app Meta : vérifie X-Hub-Signature-256. Sans lui, le webhook POST répond 403.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v24.0
# Modèle pré-approuvé par Meta pour écrire hors fenêtre de 24 h (variables : prénom, pack, gouvernorat, montant).
WHATSAPP_TEMPLATE_NAME=order_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=fr
WHATSAPP_TIMEOUT=10s

# --- Génération des messages (API Anthropic Messages) ------------------------------------
# Sans clé : gabarits déterministes.
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_BASE_URL=https://api.anthropic.com
LLM_TIMEOUT=10s
