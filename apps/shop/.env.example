# SHIFT CART — boutique (apps/shop). Copier en .env.local.

# URL de l'API Spring Boot (appelée côté serveur uniquement : catalogue, Server Action, suivi,
# et réécriture /media/:id → ${API_URL}/api/media/:id pour les photos des packs).
API_URL=http://localhost:8090

# Numéro WhatsApp de la boutique, format international sans + (+216 92 184 592).
NEXT_PUBLIC_WHATSAPP_NUMBER=21692184592

# Meta Pixel (chargé après la première interaction ; vide = aucun suivi). [À DÉFINIR]
NEXT_PUBLIC_META_PIXEL_ID=

# Vidéo UGC de la story (MP4 ≤ 15 s, ≤ 1,5 Mo) et son poster WebP (≤ 40 Ko). Vide = placeholder rayé. [À DÉFINIR]
NEXT_PUBLIC_STORY_VIDEO_SRC=
NEXT_PUBLIC_STORY_VIDEO_POSTER=

# Optionnel : URL publique du site (balises OG), liens réseaux du footer desktop (masqués si vides).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
